# --- Sanity (blog CMS) -------------------------------------------------------
# Public identifiers (safe to expose; they only allow READING published content)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# SERVER-ONLY secrets. Never prefix with NEXT_PUBLIC_. Never commit real values.
# Viewer-role token: lets draft preview read unpublished documents.
SANITY_API_READ_TOKEN=
# Random string (e.g. `openssl rand -base64 32`); must equal the webhook "Secret" in Sanity.
SANITY_REVALIDATE_SECRET=

# --- Sanity Studio (only read by `sanity dev|build|deploy`) -------------------
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Site the Presentation (preview) tool loads. http://localhost:3000 for local, the site URL for production.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000
